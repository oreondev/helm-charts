{
  "__inputs": [],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.4.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "bargauge",
      "name": "Bar gauge",
      "version": ""
    },
    {
      "type": "panel",
      "id": "gauge",
      "name": "Gauge",
      "version": ""
    },
    {
      "type": "panel",
      "id": "stat",
      "name": "Stat",
      "version": ""
    },
    {
      "type": "panel",
      "id": "table",
      "name": "Table",
      "version": ""
    },
    {
      "type": "panel",
      "id": "text",
      "name": "Text",
      "version": ""
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": ""
    }
  ],
  "uid": "oreon-k8s-cost-waste-gcom",
  "title": "Kubernetes cost, showback, waste and savings (Prometheus, OpenCost)",
  "description": "Cluster cost, showback per namespace, requests versus usage, unrequested capacity and savings levers, with node prices from static rates, instance-type prices or OpenCost. From the k8s-cost-waste-alerts Helm chart.",
  "tags": [
    "cost",
    "finops",
    "kubernetes"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "type": "stat",
      "title": "Cluster cost / month",
      "description": "Every node priced per month with the chart's pricing source (static rates, instance-type prices or OpenCost).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "costwaste:cluster_cost:per_month",
          "legendFormat": "",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      }
    },
    {
      "id": 101,
      "type": "stat",
      "title": "Requested (allocated)",
      "description": "The part of the node bill that pods have requested: what showback charges the namespaces.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(costwaste:namespace_cost:per_month)",
          "legendFormat": "",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      }
    },
    {
      "id": 102,
      "type": "stat",
      "title": "Unrequested node capacity",
      "description": "Allocatable CPU and memory no pod has requested, at each node's price. Paid for, available to nobody.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "costwaste:cluster_idle_cost:per_month",
          "legendFormat": "",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      }
    },
    {
      "id": 103,
      "type": "stat",
      "title": "Wasted: requests above usage",
      "description": "Requested but unused CPU and memory, excluding the system namespaces in excludeNamespaces (teams rarely own those).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "costwaste:waste_cost:per_month",
          "legendFormat": "",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      }
    },
    {
      "id": 104,
      "type": "stat",
      "title": "Wasted, all namespaces",
      "description": "The same including kube-system, monitoring and the other excluded namespaces.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "costwaste:waste_cost_all_namespaces:per_month",
          "legendFormat": "",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      }
    },
    {
      "id": 105,
      "type": "stat",
      "title": "Spot share of node spend",
      "description": "Share of the node bill on spot or preemptible nodes (from node labels or OpenCost).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "costwaste:cluster_spot_cost:per_month / costwaste:cluster_cost:per_month",
          "legendFormat": "",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      }
    },
    {
      "id": 106,
      "type": "table",
      "title": "Savings levers (estimates, per month)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Separate levers, not a sum: right-sizing frees capacity that consolidation then removes. Spot, commitment and headroom assumptions are chart values (savings.*).",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 14,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "costwaste:savings:per_month",
          "legendFormat": "",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "prometheus": true
            },
            "indexByName": {
              "lever": 0,
              "Value": 1
            },
            "renameByName": {
              "lever": "Lever",
              "Value": "Estimated saving / month"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Lever"
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Lever"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "rightsizing": {
                        "text": "1. Right-size requests to real usage (VPA recommendations), app namespaces only",
                        "index": 0
                      },
                      "consolidation": {
                        "text": "2. Remove unrequested node capacity (autoscaler / Karpenter consolidation, smaller node types), keeping headroom",
                        "index": 1
                      },
                      "spot": {
                        "text": "3. Move interruption-tolerant on-demand capacity to spot / preemptible nodes",
                        "index": 2
                      },
                      "commitment": {
                        "text": "4. Commit the steady 7-day minimum of on-demand spend (Savings Plans, CUDs, reservations)",
                        "index": 3
                      },
                      "idle_volumes": {
                        "text": "5. Snapshot and delete PersistentVolumeClaims no pod mounts",
                        "index": 4
                      },
                      "idle_load_balancers": {
                        "text": "6. Delete LoadBalancer services with no ready endpoints",
                        "index": 5
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.width",
                "value": 640
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Estimated saving / month"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "basic"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 107,
      "type": "bargauge",
      "title": "Cost by namespace (requested, per month)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Showback: requests priced at the node each pod runs on.",
      "gridPos": {
        "x": 14,
        "y": 4,
        "w": 10,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(12, costwaste:namespace_cost:per_month)",
          "legendFormat": "{{namespace}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 0,
          "min": 0,
          "color": {
            "mode": "continuous-BlPu"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 108,
      "type": "table",
      "title": "Nodes",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Price, capacity type and how much of each node is requested. Low-requested on-demand nodes are the consolidation candidates.",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 14,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "costwaste:node_info",
          "legendFormat": "",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "expr": "costwaste:node_cost:per_month",
          "legendFormat": "",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "C",
          "expr": "costwaste:node_spot:bool",
          "legendFormat": "",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "D",
          "expr": "costwaste:node_cpu_requests:sum / on (node) sum by (node) (max by (node, resource) (kube_node_status_allocatable{resource=\"cpu\"}))",
          "legendFormat": "",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "E",
          "expr": "costwaste:node_memory_requests:sum / on (node) sum by (node) (max by (node, resource) (kube_node_status_allocatable{resource=\"memory\"}))",
          "legendFormat": "",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "F",
          "expr": "costwaste:node_idle_cost:per_month",
          "legendFormat": "",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value #A": true,
              "__name__": true
            },
            "indexByName": {
              "node": 0,
              "instance_type": 1,
              "Value #C": 2,
              "Value #B": 3,
              "Value #D": 4,
              "Value #E": 5,
              "Value #F": 6
            },
            "renameByName": {
              "node": "Node",
              "instance_type": "Instance type",
              "Value #B": "Cost / month",
              "Value #C": "Capacity",
              "Value #D": "CPU requested",
              "Value #E": "Memory requested",
              "Value #F": "Unrequested / month"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Cost / month",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          },
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Cost / month"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Unrequested / month"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Capacity"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "on-demand"
                      },
                      "1": {
                        "text": "spot",
                        "color": "green"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".* requested"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 0.4
                    },
                    {
                      "color": "green",
                      "value": 0.65
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 109,
      "type": "timeseries",
      "title": "Monthly run rate: total, requested, unrequested",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 14,
        "y": 12,
        "w": 10,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "costwaste:cluster_cost:per_month",
          "legendFormat": "total"
        },
        {
          "refId": "B",
          "expr": "sum(costwaste:namespace_cost:per_month)",
          "legendFormat": "requested"
        },
        {
          "refId": "C",
          "expr": "costwaste:cluster_idle_cost:per_month",
          "legendFormat": "unrequested"
        },
        {
          "refId": "D",
          "expr": "costwaste:waste_cost:per_month",
          "legendFormat": "wasted (app namespaces)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 2,
      "type": "gauge",
      "title": "CPU requested / allocatable",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "costwaste:cluster_cpu_commit:ratio",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.4
              },
              {
                "color": "green",
                "value": 0.6
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      }
    },
    {
      "id": 3,
      "type": "gauge",
      "title": "CPU used / allocatable",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 6,
        "y": 20,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "costwaste:cluster_cpu_use:ratio",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.2
              },
              {
                "color": "green",
                "value": 0.4
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      }
    },
    {
      "id": 4,
      "type": "gauge",
      "title": "Memory requested / allocatable",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "costwaste:cluster_memory_commit:ratio",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.4
              },
              {
                "color": "green",
                "value": 0.6
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      }
    },
    {
      "id": 5,
      "type": "gauge",
      "title": "Memory used / allocatable",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 18,
        "y": 20,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "costwaste:cluster_memory_use:ratio",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.2
              },
