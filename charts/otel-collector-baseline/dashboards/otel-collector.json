        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (pod, processor) (rate({__name__=~\"otelcol_processor_memory_limiter_refused_spans(_total)?\", namespace=\"$namespace\", pod=~\"$pod\"}[$__rate_interval])) or sum by (pod, processor) (rate({__name__=~\"otelcol_processor_memory_limiter_refused_metric_points(_total)?\", namespace=\"$namespace\", pod=~\"$pod\"}[$__rate_interval])) or sum by (pod, processor) (rate({__name__=~\"otelcol_processor_memory_limiter_refused_log_records(_total)?\", namespace=\"$namespace\", pod=~\"$pod\"}[$__rate_interval])) or sum by (pod, processor) (rate({__name__=~\"otelcol_processor_refused_spans(_total)?\", namespace=\"$namespace\", pod=~\"$pod\"}[$__rate_interval])) or sum by (pod, processor) (rate({__name__=~\"otelcol_processor_refused_metric_points(_total)?\", namespace=\"$namespace\", pod=~\"$pod\"}[$__rate_interval])) or sum by (pod, processor) (rate({__name__=~\"otelcol_processor_refused_log_records(_total)?\", namespace=\"$namespace\", pod=~\"$pod\"}[$__rate_interval])) or sum by (pod, processor) (rate({__name__=~\"otelcol_processor_dropped_spans(_total)?\", namespace=\"$namespace\", pod=~\"$pod\"}[$__rate_interval])) or sum by (pod, processor) (rate({__name__=~\"otelcol_processor_dropped_metric_points(_total)?\", namespace=\"$namespace\", pod=~\"$pod\"}[$__rate_interval])) or sum by (pod, processor) (rate({__name__=~\"otelcol_processor_dropped_log_records(_total)?\", namespace=\"$namespace\", pod=~\"$pod\"}[$__rate_interval]))",
