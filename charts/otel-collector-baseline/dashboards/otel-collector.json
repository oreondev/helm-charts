          "legendFormat": "spans {{receiver}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (receiver) (rate({__name__=~\"otelcol_receiver_refused_metric_points(_total)?\", namespace=\"$namespace\", pod=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": "metric points {{receiver}}",
          "refId": "B"
