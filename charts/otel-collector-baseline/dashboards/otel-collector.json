            "uid": "${datasource}"
          },
          "expr": "max by (pod, exporter) (otelcol_exporter_queue_size{namespace=\"$namespace\", pod=~\"$pod\"} / otelcol_exporter_queue_capacity{namespace=\"$namespace\", pod=~\"$pod\"})",
          "legendFormat": "{{pod}} {{exporter}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Dropped or refused by processors per second",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          },
          "noValue": "None in this range"
        },
