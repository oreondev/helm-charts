            "renameByName": {
              "Value #A": "Uptime",
              "Value #B": "Restarts",
              "Value #C": "Memory RSS",
              "Value #D": "CPU (cores)"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
