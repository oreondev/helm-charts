          "legendFormat": "",
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "B",
          "expr": "sum by (pod) (kube_pod_container_status_restarts_total{namespace=\"$namespace\", pod=~\"$pod\", container=\"otc-container\"})",
          "legendFormat": "",
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "C",
          "expr": "sum by (pod) ({__name__=~\"otelcol_process_memory_rss(_bytes)?(_total)?\", namespace=\"$namespace\", pod=~\"$pod\"})",
          "legendFormat": "",
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
