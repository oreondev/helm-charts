      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum by (processor) (rate({__name__=~\"otelcol_processor_incoming_items(_total)?\", namespace=\"$namespace\", pod=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": "in {{processor}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "B",
          "expr": "sum by (processor) (rate({__name__=~\"otelcol_processor_outgoing_items(_total)?\", namespace=\"$namespace\", pod=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": "out {{processor}}"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Batch size sent (p50 / p95)",
      "description": "Items per batch. Tiny batches mean the timeout fires first (low traffic or a short timeout); batches pinned at send_batch_max_size mean the processor is saturated.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 36,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le, processor) (rate({__name__=\"otelcol_processor_batch_batch_send_size_bucket\", namespace=\"$namespace\", pod=~\"$pod\"}[$__rate_interval])))",
