          "expr": "max by (pod, exporter) (otelcol_exporter_queue_size{namespace=\"$namespace\", pod=~\"$pod\"} / otelcol_exporter_queue_capacity{namespace=\"$namespace\", pod=~\"$pod\"})",
          "legendFormat": "{{pod}} {{exporter}}",
          "refId": "A"
