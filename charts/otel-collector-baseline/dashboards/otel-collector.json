{
  "uid": "oreon-otel-collector",
  "title": "OpenTelemetry collectors",
  "tags": [
    "opentelemetry",
    "otel-collector",
    "oreonit"
  ],
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Data source",
        "current": {},
        "hide": 0
      },
      {
        "name": "namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "label": "Namespace",
        "refresh": 2,
        "sort": 1,
        "includeAll": false,
        "current": {},
        "query": {
          "query": "label_values({__name__=~\"otelcol_process_uptime(_seconds)?(_total)?\"}, namespace)",
          "refId": "ns"
        },
        "definition": "label_values({__name__=~\"otelcol_process_uptime(_seconds)?(_total)?\"}, namespace)"
      },
      {
        "name": "pod",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "label": "Pod",
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "query": {
          "query": "label_values({__name__=~\"otelcol_process_uptime(_seconds)?(_total)?\", namespace=\"$namespace\"}, pod)",
          "refId": "pod"
        },
        "definition": "label_values({__name__=~\"otelcol_process_uptime(_seconds)?(_total)?\", namespace=\"$namespace\"}, pod)"
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Collector pods",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count({__name__=~\"otelcol_process_uptime(_seconds)?(_total)?\", namespace=\"$namespace\", pod=~\"$pod\"})",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Export failures (5m)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "(sum(increase({__name__=~\"otelcol_exporter_send_failed_spans(_total)?\", namespace=\"$namespace\", pod=~\"$pod\"}[5m])) or vector(0)) + (sum(increase({__name__=~\"otelcol_exporter_send_failed_metric_points(_total)?\", namespace=\"$namespace\", pod=~\"$pod\"}[5m])) or vector(0)) + (sum(increase({__name__=~\"otelcol_exporter_send_failed_log_records(_total)?\", namespace=\"$namespace\", pod=~\"$pod\"}[5m])) or vector(0))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Refused by receivers (5m)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "(sum(increase({__name__=~\"otelcol_receiver_refused_spans(_total)?\", namespace=\"$namespace\", pod=~\"$pod\"}[5m])) or vector(0)) + (sum(increase({__name__=~\"otelcol_receiver_refused_metric_points(_total)?\", namespace=\"$namespace\", pod=~\"$pod\"}[5m])) or vector(0)) + (sum(increase({__name__=~\"otelcol_receiver_refused_log_records(_total)?\", namespace=\"$namespace\", pod=~\"$pod\"}[5m])) or vector(0))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Busiest exporter queue",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 0.8
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(otelcol_exporter_queue_size{namespace=\"$namespace\", pod=~\"$pod\"} / otelcol_exporter_queue_capacity{namespace=\"$namespace\", pod=~\"$pod\"}) or vector(0)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Received per second (accepted by receiver)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (receiver) (rate({__name__=~\"otelcol_receiver_accepted_spans(_total)?\", namespace=\"$namespace\", pod=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": "spans {{receiver}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (receiver) (rate({__name__=~\"otelcol_receiver_accepted_metric_points(_total)?\", namespace=\"$namespace\", pod=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": "metric points {{receiver}}",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (receiver) (rate({__name__=~\"otelcol_receiver_accepted_log_records(_total)?\", namespace=\"$namespace\", pod=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": "log records {{receiver}}",
          "refId": "C"
        }
      ]
    },
