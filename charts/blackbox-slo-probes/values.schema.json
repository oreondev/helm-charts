{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "blackbox-slo-probes values",
  "type": "object",
  "properties": {
    "blackbox": {
      "type": "object",
      "properties": {
        "url": { "type": "string", "minLength": 1 },
        "scheme": { "type": "string", "enum": ["http", "https"] },
        "path": { "type": "string" }
      },
      "additionalProperties": false
    },
    "probe": {
      "type": "object",
      "properties": {
        "jobName": { "type": "string", "minLength": 1 },
        "interval": { "$ref": "#/definitions/duration" },
        "scrapeTimeout": { "$ref": "#/definitions/duration" },
        "module": { "type": "string" },
        "namespace": { "type": "string" },
        "labels": { "$ref": "#/definitions/stringMap" }
      },
      "additionalProperties": false
    },
    "sloPeriodDays": { "type": "integer", "minimum": 1, "maximum": 365 },
    "prometheusRule": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "namespace": { "type": "string" },
        "labels": { "$ref": "#/definitions/stringMap" },
        "interval": { "$ref": "#/definitions/duration" }
      },
      "additionalProperties": false
    },
    "dashboard": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "namespace": { "type": "string" },
        "labels": { "$ref": "#/definitions/stringMap" },
        "annotations": { "$ref": "#/definitions/stringMap" }
      },
      "additionalProperties": false
    },
    "alerting": {
      "type": "object",
      "properties": {
        "alertNamePrefix": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
        "labels": { "$ref": "#/definitions/stringMap" },
        "annotations": { "$ref": "#/definitions/stringMap" },
        "page": { "$ref": "#/definitions/alertClass" },
        "ticket": { "$ref": "#/definitions/alertClass" },
        "probeDown": {
          "type": "object",
          "properties": { "enabled": { "type": "boolean" }, "severity": { "type": "string" }, "for": { "$ref": "#/definitions/duration" } },
          "additionalProperties": false
        },
        "tlsExpiry": {
          "type": "object",
          "properties": { "enabled": { "type": "boolean" }, "severity": { "type": "string" }, "days": { "type": "number", "minimum": 1 } },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "url"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$", "maxLength": 50 },
          "url": { "type": "string", "minLength": 1 },
          "service": { "type": "string" },
          "module": { "type": "string" },
          "labels": { "$ref": "#/definitions/stringMap" },
          "availability": {
            "type": "object",
            "properties": { "objective": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 100 } },
            "additionalProperties": false
          },
          "latency": {
            "type": "object",
            "required": ["objective", "threshold"],
            "properties": {
              "objective": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 100 },
              "threshold": { "type": "number", "exclusiveMinimum": 0 }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "definitions": {
    "stringMap": { "type": "object", "additionalProperties": { "type": "string" } },
    "duration": { "type": "string", "pattern": "^[0-9]+(ms|s|m|h|d|w)$" },
    "window": {
      "type": "object",
      "required": ["long", "short", "factor"],
      "properties": {
        "long": { "$ref": "#/definitions/duration" },
        "short": { "$ref": "#/definitions/duration" },
        "factor": { "type": "number", "exclusiveMinimum": 0 }
      },
      "additionalProperties": false
    },
    "alertClass": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "severity": { "type": "string" },
        "for": { "$ref": "#/definitions/duration" },
        "windows": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/window" } }
      },
      "additionalProperties": false
    }
  }
}
