{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "alertmanager-routing-baseline values",
  "type": "object",
  "properties": {
    "name": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" },
    "labels": { "$ref": "#/definitions/stringMap" },
    "route": {
      "type": "object",
      "properties": {
        "groupBy": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "groupWait": { "$ref": "#/definitions/duration" },
        "groupInterval": { "$ref": "#/definitions/duration" },
        "repeatInterval": { "$ref": "#/definitions/duration" },
        "pageRepeatInterval": { "$ref": "#/definitions/duration" }
      },
      "additionalProperties": false
    },
    "severity": {
      "type": "object",
      "properties": {
        "label": { "type": "string" },
        "page": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "ticket": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "info": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      },
      "additionalProperties": false
    },
    "receivers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "slack": { "type": "object" },
          "pagerduty": { "type": "object" },
          "opsgenie": { "type": "object" },
          "email": { "type": "object" },
          "msteams": { "type": "object" },
          "webhook": { "type": "object" }
        },
        "additionalProperties": false,
        "minProperties": 1
      }
    },
    "slackDefaults": {
      "type": "object",
      "properties": { "title": { "type": "string" }, "text": { "type": "string" } },
      "additionalProperties": false
    },
    "teams": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "matchers"],
        "properties": {
          "name": { "type": "string" },
          "matchers": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/matcher" } },
          "page": { "type": "string" },
          "ticket": { "type": "string" },
          "info": { "type": "string" },
          "muteTicketsOutsideBusinessHours": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "fallback": {
      "type": "object",
      "properties": { "receiver": { "type": "string" }, "page": { "type": "string" } },
      "additionalProperties": false
    },
    "watchdog": {
      "type": "object",
      "properties": { "enabled": { "type": "boolean" }, "alertname": { "type": "string" }, "receiver": { "type": "string" } },
      "additionalProperties": false
    },
    "inhibit": {
      "type": "object",
      "properties": {
        "criticalInhibitsWarning": { "type": "boolean" },
        "pageInhibitsTicket": { "type": "boolean" },
        "extra": { "type": "array", "items": { "type": "object" } }
      },
      "additionalProperties": false
    },
    "timeIntervals": {
      "type": "object",
      "properties": {
        "businessHours": {
          "type": "object",
          "properties": {
            "weekdays": { "type": "array", "items": { "type": "string" } },
            "start": { "type": "string", "pattern": "^[0-2][0-9]:[0-5][0-9]$" },
            "end": { "type": "string", "pattern": "^[0-2][0-9]:[0-5][0-9]$" }
          },
          "additionalProperties": false
        },
        "extra": { "type": "array", "items": { "type": "object" } }
      },
      "additionalProperties": false
    },
    "extraRoutes": { "type": "array", "items": { "type": "object" } },
    "nullReceiver": { "type": "string" }
  },
  "definitions": {
    "stringMap": { "type": "object", "additionalProperties": { "type": "string" } },
    "duration": { "type": "string", "pattern": "^[0-9]+(ms|s|m|h|d|w|y)$" },
    "matcher": {
      "oneOf": [
        { "type": "string", "pattern": "^[^=!~]+(=~|!~|!=|=).+$" },
        {
          "type": "object",
          "required": ["name", "value"],
          "properties": {
            "name": { "type": "string" },
            "value": { "type": ["string", "number", "boolean"] },
            "matchType": { "type": "string", "enum": ["=", "!=", "=~", "!~"] }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
