          "type": "object",
          "additionalProperties": false,
          "properties": {
            "matchLabels": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kubernetes.io/metadata.name": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
