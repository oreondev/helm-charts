            "failureThreshold": {
              "type": [
                "integer",
                "string"
              ]
            }
          }
        },
        "liveness": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "periodSeconds": {
              "type": [
                "integer",
                "string"
              ]
            },
            "timeoutSeconds": {
              "type": [
                "integer",
                "string"
              ]
            }
          }
        },
        "readiness": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "periodSeconds": {
              "type": [
                "integer",
                "string"
              ]
            },
            "timeoutSeconds": {
              "type": [
                "integer",
                "string"
              ]
            }
          }
        }
      }
    },
    "extraObjects": {
      "type": "array"
    }
  }
