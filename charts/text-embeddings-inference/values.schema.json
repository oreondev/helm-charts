            "labels": {
              "type": "object"
            }
          }
        },
        "prometheusRule": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "labels": {
              "type": "object"
            },
            "latencySeconds": {
              "type": [
                "integer",
                "string"
              ]
            },
            "queueSize": {
              "type": [
                "integer",
                "string"
              ]
            },
            "failureRatio": {
              "type": [
                "number",
                "string"
              ]
            }
          }
        },
        "dashboard": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "labels": {
              "type": "object"
            },
            "annotations": {
              "type": "object"
            }
          }
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": [
            "string",
            "integer"
          ]
        },
        "annotations": {
          "type": "object"
        }
      }
    },
    "automountServiceAccountToken": {
      "type": "boolean"
    },
    "podAnnotations": {
      "type": "object"
    },
    "podLabels": {
      "type": "object"
    },
    "priorityClassName": {
      "type": [
        "string",
        "integer"
      ]
    },
    "affinity": {
      "type": "object"
    },
    "podSecurityContext": {
