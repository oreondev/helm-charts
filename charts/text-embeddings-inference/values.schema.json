  "type": "object",
  "additionalProperties": false,
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string"
        },
        "tag": {
          "type": [
            "string",
            "integer"
          ]
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "nameOverride": {
      "type": [
        "string",
        "integer"
      ]
    },
    "fullnameOverride": {
      "type": [
        "string",
        "integer"
      ]
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "apiKey": {
          "type": [
            "string",
            "integer"
          ]
        },
        "existingSecret": {
          "type": [
            "string",
            "integer"
          ]
        },
        "existingSecretKey": {
          "type": "string"
        }
      }
    },
    "huggingface": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "token": {
          "type": [
            "string",
            "integer"
          ]
        },
        "existingSecret": {
          "type": [
            "string",
            "integer"
          ]
        },
        "existingSecretKey": {
          "type": "string"
        }
      }
    },
