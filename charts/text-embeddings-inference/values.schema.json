        "additionalProperties": false,
        "properties": {
          "accelerator": {
            "enum": [
              "cpu",
              "cpu-arm64",
              "turing",
              "ampere",
              "ampere-86",
              "ada",
              "hopper",
              "blackwell",
              "blackwell-120"
            ]
          },
          "revision": {
            "type": [
              "string",
              "integer"
            ]
          },
          "dtype": {
            "type": [
              "string",
              "integer"
            ]
          },
          "pooling": {
            "type": [
              "string",
              "integer"
            ]
          },
          "maxConcurrentRequests": {
            "type": [
              "integer",
              "string"
            ]
          },
          "maxBatchTokens": {
            "type": [
              "integer",
              "string"
            ]
          },
          "maxClientBatchSize": {
            "type": [
              "integer",
              "string"
            ]
          },
          "autoTruncate": {
            "type": "boolean"
          },
          "payloadLimit": {
            "type": [
              "integer",
              "string"
            ]
          },
          "replicaCount": {
            "type": [
              "integer",
              "string"
            ]
          },
          "resources": {
            "type": "object"
          },
          "cache": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "mode": {
                "enum": [
                  "emptyDir",
                  "persistent",
                  "existingClaim"
                ]
              },
              "size": {
                "type": "string"
              },
              "storageClass": {
                "type": [
                  "string",
                  "integer"
                ]
              },
              "existingClaim": {
                "type": [
                  "string",
                  "integer"
                ]
              }
            }
          },
          "autoscaling": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "minReplicas": {
                "type": [
                  "integer",
                  "string"
                ]
              },
              "maxReplicas": {
                "type": [
                  "integer",
                  "string"
                ]
              },
              "targetCPUUtilizationPercentage": {
                "type": [
                  "integer",
                  "string"
                ]
              },
              "keda": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "enabled": {
                    "type": "boolean"
                  },
                  "prometheusAddress": {
                    "type": "string"
                  },
                  "queuedPerReplica": {
                    "type": [
                      "integer",
                      "string"
                    ]
                  }
                }
              }
            }
          },
          "nodeSelector": {
            "type": "object"
          },
          "tolerations": {
            "type": "array"
          },
          "runtimeClassName": {
            "type": [
              "string",
              "integer"
            ]
          },
          "extraArgs": {
            "type": "array"
          },
          "env": {
            "type": "array"
          },
          "name": {
            "type": "string"
          },
          "modelId": {
            "type": "string"
          }
