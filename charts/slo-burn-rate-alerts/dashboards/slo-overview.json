{
  "uid": "oreon-slo-overview",
  "title": "SLO overview and burn rates",
  "description": "SLI, error budget and multi-window burn rates for the SLOs generated by the slo-burn-rate-alerts Helm chart.",
  "tags": ["slo", "sre", "error-budget"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": { "from": "now-24h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "slo",
        "label": "SLO",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "definition": "label_values(slo:objective:ratio, slo)",
        "query": { "query": "label_values(slo:objective:ratio, slo)", "refId": "slo" },
        "refresh": 2,
        "sort": 1,
        "includeAll": false,
        "multi": false,
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Objective",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 5, "w": 4, "x": 0, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "slo:objective:ratio{slo=\"$slo\"}", "instant": true, "legendFormat": "objective" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "decimals": 3, "color": { "mode": "fixed", "fixedColor": "blue" } },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "none", "textMode": "value" }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "SLI over __PERIOD__",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 5, "w": 5, "x": 4, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "1 - slo:sli_error:ratio_rate__PERIOD__{slo=\"$slo\"}", "instant": true, "legendFormat": "sli" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "decimals": 3, "color": { "mode": "fixed", "fixedColor": "green" } },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "none", "textMode": "value" }
    },
    {
      "id": 3,
      "type": "gauge",
      "title": "Error budget remaining (__PERIOD__)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 5, "w": 6, "x": 9, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "slo:error_budget_remaining:ratio{slo=\"$slo\"}", "instant": true, "legendFormat": "remaining" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.25 },
              { "color": "green", "value": 0.5 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showThresholdLabels": false, "showThresholdMarkers": true }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Burn rate, last 1h",
      "description": "1 = exactly the budget; 14.4 = page threshold for the 1h window.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 5, "w": 4, "x": 15, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "slo:error_budget_burn_rate:ratio_rate1h{slo=\"$slo\"}", "instant": true, "legendFormat": "1h" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 6 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "area", "textMode": "value" }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Burn rate, last 6h",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 5, "w": 5, "x": 19, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "slo:error_budget_burn_rate:ratio_rate6h{slo=\"$slo\"}", "instant": true, "legendFormat": "6h" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 6 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "area", "textMode": "value" }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Burn rate by window (log scale)",
      "description": "Page fires when both 1h and 5m exceed 14.4, or both 6h and 30m exceed 6. Ticket fires at 3 (1d/2h) and 1 (3d/6h). Dashed lines mark the thresholds.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 9, "w": 14, "x": 0, "y": 5 },
      "targets": [
        { "refId": "A", "expr": "slo:error_budget_burn_rate:ratio_rate1h{slo=\"$slo\"}", "legendFormat": "1h" },
        { "refId": "B", "expr": "slo:error_budget_burn_rate:ratio_rate6h{slo=\"$slo\"}", "legendFormat": "6h" },
        { "refId": "C", "expr": "slo:error_budget_burn_rate:ratio_rate1d{slo=\"$slo\"}", "legendFormat": "1d" },
        { "refId": "D", "expr": "slo:error_budget_burn_rate:ratio_rate3d{slo=\"$slo\"}", "legendFormat": "3d" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "spanNulls": true,
            "scaleDistribution": { "type": "log", "log": 10 },
            "thresholdsStyle": { "mode": "dashed" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "transparent", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "orange", "value": 3 },
              { "color": "red", "value": 6 },
              { "color": "dark-red", "value": 14.4 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Error ratio (5m) against the budget",
      "description": "Share of bad events over the last 5 minutes. The flat line is the error budget: the error ratio the SLO allows on average over the period.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 9, "w": 10, "x": 14, "y": 5 },
      "targets": [
        { "refId": "A", "expr": "slo:sli_error:ratio_rate5m{slo=\"$slo\"}", "legendFormat": "error ratio 5m" },
        { "refId": "B", "expr": "slo:error_budget:ratio{slo=\"$slo\"}", "legendFormat": "error budget" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "spanNulls": true }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "error budget" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } },
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [10, 10] } },
              { "id": "custom.fillOpacity", "value": 0 }
            ]
          }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "none" } }
    },
    {
      "id": 8,
      "type": "table",
      "title": "All SLOs",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 9, "w": 14, "x": 0, "y": 14 },
      "targets": [
        { "refId": "A", "expr": "slo:objective:ratio", "instant": true, "format": "table" },
        { "refId": "B", "expr": "1 - slo:sli_error:ratio_rate__PERIOD__", "instant": true, "format": "table" },
        { "refId": "C", "expr": "slo:error_budget_remaining:ratio", "instant": true, "format": "table" },
        { "refId": "D", "expr": "slo:error_budget_burn_rate:ratio_rate1h", "instant": true, "format": "table" }
      ],
      "transformations": [
        { "id": "merge", "options": {} },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "__name__": true, "job": true, "instance": true },
            "indexByName": { "slo": 0, "service": 1, "Value #A": 2, "Value #B": 3, "Value #C": 4, "Value #D": 5 },
            "renameByName": { "Value #A": "Objective", "Value #B": "SLI (__PERIOD__)", "Value #C": "Budget left", "Value #D": "Burn rate 1h" }
          }
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto", "cellOptions": { "type": "auto" } } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Objective" }, "properties": [ { "id": "unit", "value": "percentunit" }, { "id": "decimals", "value": 3 } ] },
          { "matcher": { "id": "byName", "options": "SLI (__PERIOD__)" }, "properties": [ { "id": "unit", "value": "percentunit" }, { "id": "decimals", "value": 3 } ] },
          {
            "matcher": { "id": "byName", "options": "Budget left" },
            "properties": [
              { "id": "unit", "value": "percentunit" },
              { "id": "decimals", "value": 1 },
              { "id": "custom.cellOptions", "value": { "type": "color-background" } },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "orange", "value": 0.25 }, { "color": "green", "value": 0.5 } ] } }
            ]
          },
          { "matcher": { "id": "byName", "options": "Burn rate 1h" }, "properties": [ { "id": "decimals", "value": 2 } ] }
        ]
      },
      "options": { "showHeader": true, "sortBy": [ { "displayName": "Budget left", "desc": false } ] }
    },
    {
      "id": 9,
      "type": "table",
      "title": "Firing SLO alerts",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 9, "w": 10, "x": 14, "y": 14 },
      "targets": [
        { "refId": "A", "expr": "ALERTS{alertstate=\"firing\", slo=~\".+\"}", "instant": true, "format": "table" }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "__name__": true, "Value": true, "alertstate": true, "job": true, "instance": true },
            "indexByName": { "alertname": 0, "slo": 1, "service": 2, "severity": 3, "slo_alert_type": 4 }
          }
        }
      ],
      "fieldConfig": { "defaults": { "custom": { "align": "auto", "cellOptions": { "type": "auto" } } }, "overrides": [] },
      "options": { "showHeader": true }
    },
    {
      "id": 10,
      "type": "text",
      "title": "",
      "gridPos": { "h": 2, "w": 24, "x": 0, "y": 23 },
      "options": {
        "mode": "markdown",
        "content": "Generated by the [slo-burn-rate-alerts](https://github.com/oreonit/helm-charts) Helm chart. Burn-rate windows follow the Google SRE Workbook. Maintained by [Oreon IT](https://www.oreonit.com/)."
      }
    }
  ]
}
